# Copy to .env and fill in values. NEVER commit .env. Names only; no values are stored in git.

# Server
NODE_ENV=
PORT=
PUBLIC_BASE_URL=

# MySQL
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=
DB_SOCKS_HOST=
DB_SOCKS_PORT=
DB_USER=

# CRM auth
CRM_ADMIN_PASSWORD=
CRM_ADMIN_USER=
CRM_SSO_SECRET=
MESSENGER_WEBHOOK_SECRET=

# Payments (Zarinpal)
CRM_PAYMENT_LINK_BASE=
ZARINPAL_CURRENCY=
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=

# SMS
CRM_DEBT_SMS_ENABLED=
CRM_DEBT_SMS_TEST_MOBILE=
SMS_API_KEY=
SMS_SENDER_LINE=

# Gemini OCR
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_BASE_URL=
GEMINI_MODEL=

# AI Copilot
COPILOT_API_KEY=
COPILOT_API_URL=
COPILOT_DBHUB_TOKEN=
COPILOT_DBHUB_URL=
COPILOT_DB_BACKEND=
COPILOT_MODEL=
COPILOT_RO_DB_PASSWORD=
COPILOT_RO_DB_USER=
COPILOT_SQL_ENABLED=

# Messengers
RUBIKA_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_PROXY=

# Umami analytics
UMAMI_PASSWORD=
UMAMI_URL=
UMAMI_USERNAME=
UMAMI_WEBSITE_ID=

# Deploy
# Signs staff sessions / trainee tokens; when empty a random secret is kept in .crm-jwt-secret
CRM_JWT_SECRET=
# Real bulk (Rubika/SMS) campaign sending; dry-run unless 1
CRM_BULK_SEND_ENABLED=
# Reverse proxies in front of the app (default 1 = nginx). Leave commented: an EMPTY value disables trust.
# TRUST_PROXY=1

# Rule-based automation (automation.ts). OFF unless set to 1.
CRM_AUTOMATION_ENABLED=
# When set, every automation SMS goes to this number instead of the real recipient.
CRM_AUTOMATION_TEST_MOBILE=
# Global cap of automation SMS per Tehran day, and the Tehran hour of the daily scheduled run.
CRM_AUTOMATION_MAX_SMS_PER_DAY=
CRM_AUTOMATION_DAILY_HOUR=
# Admin chats for the notify-admin action. Empty skips that action.
CRM_AUTOMATION_ADMIN_TELEGRAM_CHAT=
CRM_AUTOMATION_ADMIN_RUBIKA_CHAT=

# Email (transactional + campaigns). Nothing is sent unless CRM_EMAIL_ENABLED=1 and SMTP_HOST + CRM_EMAIL_FROM are set.
CRM_EMAIL_ENABLED=
CRM_EMAIL_TEST_TO=
SMTP_HOST=
SMTP_PORT=
# 1 = implicit TLS (usually port 465); 0 = STARTTLS (usually port 587)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
CRM_EMAIL_FROM=
CRM_EMAIL_FROM_NAME=
CRM_EMAIL_MAX_PER_HOUR=
CRM_EMAIL_THROTTLE_MS=
# Changing this invalidates unsubscribe links already sent.
CRM_EMAIL_UNSUB_SECRET=
