# Copy to .env (never commit). Used by docker compose and the Node server.

PORT=3000
NODE_ENV=production

# Chabokan MySQL
DB_HOST=services.irn5.chabokan.net
DB_PORT=52691
DB_USER=nodejs430_carla
DB_NAME=nodejs430_carla
DB_PASSWORD=

# Only for this OpenClaw/GCP stack. Empty on Chabokan.
DB_SOCKS_HOST=
DB_SOCKS_PORT=1081

# Optional login fallback if staff_users hash is unknown
CRM_ADMIN_USER=admin
CRM_ADMIN_PASSWORD=

# Shared secret for POST /api/messenger/webhook (sent as the x-webhook-secret header).
# Required: when empty the webhook answers 403 and stores nothing.
MESSENGER_WEBHOOK_SECRET=

# Zarinpal online installments. Sandbox unless ZARINPAL_SANDBOX=0. Merchant id is a placeholder only.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=1
# IRR (default, Toman*10) or IRT (already Toman)
ZARINPAL_CURRENCY=IRR
# Public origin used in gateway callback / trainee links (defaults to the request host).
PUBLIC_BASE_URL=

# Remaining-debt SMS (via sms.ir): one message per debtor with the whole balance + a payment link.
# Off unless CRM_DEBT_SMS_ENABLED=1 (a hard gate; settings can only disable). Test mode: when
# CRM_DEBT_SMS_TEST_MOBILE is set it is the ONLY number that can ever receive (everyone else is logged
# as skipped_test_mode). At most one SMS per trainee per day.
CRM_DEBT_SMS_ENABLED=
CRM_DEBT_SMS_TEST_MOBILE=
# Official sms.ir SDK (Smsir class); template params NAME / AMOUNT / CODE. Never commit real keys.
SMSIR_API_KEY=
SMSIR_LINE_NUMBER=
SMSIR_DEBT_TEMPLATE_ID=472328
# Public base of the payment link put in the SMS; the short code is appended (link = base + code).
CRM_PAYMENT_LINK_BASE=https://kermanshahcart.ir/p/

GEMINI_API_KEY=
# Optional: extra keys (comma separated); when one hits its quota OCR moves to the next.
GEMINI_API_KEYS=
# Optional: relay endpoint when the server cannot reach Google directly, and a preferred model
GEMINI_BASE_URL=
GEMINI_MODEL=
