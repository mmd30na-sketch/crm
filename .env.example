# Copy to .env and fill in values. NEVER commit .env. Names only; no values are stored in git.

# Server
NODE_ENV=
PORT=
# Public origin of this CRM (used for Zarinpal callback/StartPay links), e.g. https://management.kermanshahcart.ir
PUBLIC_BASE_URL=

# MySQL
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=
DB_SOCKS_HOST=
DB_SOCKS_PORT=
DB_USER=

# CRM auth
CRM_ADMIN_PASSWORD=
CRM_ADMIN_USER=
CRM_SSO_SECRET=
MESSENGER_WEBHOOK_SECRET=

# Payments (Zarinpal)
CRM_PAYMENT_LINK_BASE=
# IRR (default) or IRT. Amounts in the CRM are Toman: IRR sends Toman*10 (Rial), IRT sends Toman as-is.
ZARINPAL_CURRENCY=
ZARINPAL_MERCHANT_ID=
# 1 or true = sandbox; 0, empty or anything else = PRODUCTION. Leave empty in production!
ZARINPAL_SANDBOX=
# Zarinpal GraphQL API (read-only use: connection test + transaction sync). Settings → درگاه پرداخت overrides.
ZARINPAL_ACCESS_TOKEN=
# Shared secret for the internal POST /api/internal/site-tuition-ledger nudge (loopback only).
# Keep the placeholder empty here; never put a real secret into git. Empty disables the endpoint (503).
INTERNAL_LEDGER_SECRET=

# SMS (sms.ir via the official `sms-typescript` SDK). The key stays env-only and never goes into the database or git.
# Verify needs SMS_API_KEY plus an approved template. Bulk also needs a line:
# app_settings sms.config.lineNumber first, SMS_SENDER_LINE only when that is empty.
CRM_DEBT_SMS_ENABLED=
CRM_DEBT_SMS_TEST_MOBILE=
SMS_API_KEY=
SMS_SENDER_LINE=

# Gemini OCR
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_BASE_URL=
GEMINI_MODEL=
# Per-attempt Gemini OCR timeout (ms, clamped 3000-25000). Lets later models/keys run if one hangs.
GEMINI_OCR_ATTEMPT_TIMEOUT_MS=12000
# Optional OpenAI-compatible vision fallback after Gemini fails (defaults to COPILOT_API_URL / COPILOT_API_KEY).
OCR_VISION_API_URL=
OCR_VISION_API_KEY=
OCR_VISION_MODELS=

# AI Copilot
COPILOT_API_KEY=
COPILOT_API_URL=
COPILOT_DBHUB_TOKEN=
COPILOT_DBHUB_URL=
COPILOT_DIRECTUS_TOKEN=
COPILOT_DIRECTUS_URL=
COPILOT_DB_BACKEND=
COPILOT_MODEL=
# Optional comma-separated fallback model ids tried on 429/5xx/quota/network/empty reply.
# Leave empty to use the built-in free OmniRoute list from docs/copilot.md.
COPILOT_MODEL_FALLBACKS=
COPILOT_RO_DB_PASSWORD=
COPILOT_RO_DB_USER=
COPILOT_SQL_ENABLED=

# Messengers
RUBIKA_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_PROXY=

# Umami analytics
UMAMI_PASSWORD=
UMAMI_URL=
UMAMI_USERNAME=
UMAMI_WEBSITE_ID=

# Deploy
# Signs staff sessions / trainee tokens; when empty a random secret is kept in .crm-jwt-secret
CRM_JWT_SECRET=
# Real bulk (Rubika/SMS) campaign sending; dry-run unless 1
CRM_BULK_SEND_ENABLED=
# Reverse proxies in front of the app (default 1 = nginx). Leave commented: an EMPTY value disables trust.
# TRUST_PROXY=1

# Rule-based automation (automation.ts). OFF unless set to 1.
CRM_AUTOMATION_ENABLED=
# When set, every automation SMS goes to this number instead of the real recipient.
CRM_AUTOMATION_TEST_MOBILE=
# Global cap of automation SMS per Tehran day, and the Tehran hour of the daily scheduled run.
CRM_AUTOMATION_MAX_SMS_PER_DAY=
CRM_AUTOMATION_DAILY_HOUR=
# Admin chats for the notify-admin action. Empty skips that action.
CRM_AUTOMATION_ADMIN_TELEGRAM_CHAT=
CRM_AUTOMATION_ADMIN_RUBIKA_CHAT=

# Email (transactional + campaigns). Nothing is sent unless CRM_EMAIL_ENABLED=1 and SMTP_HOST + CRM_EMAIL_FROM are set.
CRM_EMAIL_ENABLED=
CRM_EMAIL_TEST_TO=
SMTP_HOST=
SMTP_PORT=
# 1 = implicit TLS (usually port 465); 0 = STARTTLS (usually port 587)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
CRM_EMAIL_FROM=
CRM_EMAIL_FROM_NAME=
CRM_EMAIL_MAX_PER_HOUR=
CRM_EMAIL_THROTTLE_MS=
# Changing this invalidates unsubscribe links already sent.
CRM_EMAIL_UNSUB_SECRET=
