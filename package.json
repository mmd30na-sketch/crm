{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "scanner": "node scripts/scanner-bridge.mjs",
    "test:ocr": "node --import tsx scripts/test-ocr-validate.mjs",
    "test:logic": "node --import tsx scripts/test-crm-logic.mjs",
    "test:print": "node --import tsx scripts/test-print-docs.mjs",
    "test:copilot-date": "node --import tsx scripts/test-copilot-date.mjs",
    "test:copilot-labels": "node --import tsx scripts/test-copilot-labels.mjs",
    "test:copilot-eval": "esbuild scripts/copilot-eval/run-eval.ts --bundle --platform=node --format=cjs --packages=external --outfile=scripts/copilot-eval/.run-eval.cjs --log-level=error && node scripts/copilot-eval/.run-eval.cjs",
    "preflight": "node scripts/preflight-check.mjs"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/better-sqlite3": "^9.6.0",
    "@types/multer": "^2.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "jalaali-js": "^2.0.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "mysql2": "^3.24.4",
    "node-sql-parser": "^5.4.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-easy-crop": "^5.5.7",
    "react-is": "^19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.0",
    "remark-gfm": "^4.0.1",
    "vite": "^6.2.3",
    "zarinpal-node-sdk": "^2.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jalaali-js": "^1.2.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
